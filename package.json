{
  "name": "coinpayments",
  "version": "2.2.0",
  "description": "CoinPayments is a cloud wallet solution that offers an easy way to integrate a checkout system for numerous cryptocurrencies. Coinpayments now also offers coin conversion via Shapeshift.io.",
  "homepage": "https://www.coinpayments.net",
  "bugs": {
    "url": "https://github.com/OrahKokos/coinpayments/issues",
    "email": "marko.paroski.ns@gmail.com"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "build": "rm -rf dist/ && pnpm tsc",
    "prepublishOnly": "pnpm build"
  },
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./v1": {
      "require": "./dist/v1/index.js",
      "types": "./dist/v1/index.d.ts"
    },
    "./v2": {
      "require": "./dist/v2/index.js",
      "types": "./dist/v2/index.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/OrahKokos/coinpayments.git"
  },
  "author": "Marko Paroški",
  "person": {
    "name": "Marko Paroški",
    "email": "marko.paroski.ns@gmail.com",
    "url": "https://github.com/OrahKokos"
  },
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.15.18",
    "npm-check-updates": "^18.0.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
