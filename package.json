{
  "name": "coinpayments",
  "version": "2.2.0",
  "description": "CoinPayments is a cloud wallet solution that offers an easy way to integrate a checkout system for numerous cryptocurrencies. Coinpayments now also offers coin conversion via Shapeshift.io.",
  "homepage": "https://www.coinpayments.net",
  "bugs": {
    "url": "https://github.com/OrahKokos/coinpayments/issues",
    "email": "marko.paroski.ns@gmail.com"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "format-and-lint": "biome check .",
    "format-and-lint:fix": "biome check . --write",
    "build:types": "pnpm tsc",
    "build:esm": "pnpx esbuild src/index.ts --platform=node --target=node22 --format=esm --outdir=dist/esm",
    "build:cjs": "pnpx esbuild src/index.ts --platform=node --target=node22 --format=cjs --outdir=dist/cjs",
    "build": "rm -rf dist/ && pnpm build:types && pnpm build:esm && pnpm build:cjs",
    "test": "jest --config ./jest.config.js --coverage --runInBand",
    "test:debug": "node --inspect node_modules/.bin/jest --runInBand",
    "prepublishOnly": "pnpm build"
  },
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/cjs/index.js",
      "import": "./dist/esm/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/OrahKokos/coinpayments.git"
  },
  "author": "Marko Paroški",
  "person": {
    "name": "Marko Paroški",
    "email": "marko.paroski.ns@gmail.com",
    "url": "https://github.com/OrahKokos"
  },
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "esbuild": "^0.24.2",
    "jest": "^29.7.0",
    "nock": "^13.5.6",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
